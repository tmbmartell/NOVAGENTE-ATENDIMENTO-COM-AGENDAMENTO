FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HF_HOME=/models
WORKDIR /worker
COPY services/meeting-worker/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY services/meeting-worker/worker.py .
RUN mkdir -p /models && chown -R 100:101 /models
USER 100:101
CMD ["python", "-u", "worker.py"]
